@model WebBTL.Models.tblTinTuc

@{
    ViewBag.Title = "Edit Article";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2 class="text-primary">Chỉnh sửa bài viết</h2>

@using (Html.BeginForm("Edit", "AdmintblTinTucs", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="container bg-light p-4 rounded shadow-sm">
        <h4 class="text-secondary">Thông tin bài viết</h4>
        <hr />

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.PostID)

        <!-- Tiêu đề -->
        <div class="form-group row">
            @Html.LabelFor(model => model.Title, htmlAttributes: new { @class = "col-md-3 col-form-label font-weight-bold" })
            <div class="col-md-9">
                @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
            </div>
        </div>

        <!-- Nội dung -->
        <div class="form-group row">
            @Html.LabelFor(model => model.Contents, htmlAttributes: new { @class = "col-md-3 col-form-label font-weight-bold" })
            <div class="col-md-9">
                <textarea id="contents" name="Contents" class="form-control" rows="10">@Model.Contents</textarea>
                @Html.ValidationMessageFor(model => model.Contents, "", new { @class = "text-danger" })
            </div>
        </div>

        <!-- Ảnh đại diện -->
        <div class="form-group row">
            @Html.LabelFor(model => model.Thumb, htmlAttributes: new { @class = "col-md-3 col-form-label font-weight-bold" })
            <div class="col-md-9">
                <input type="file" name="image" id="image" class="form-control-file" accept="image/*" />
                @if (!string.IsNullOrEmpty(Model.Thumb))
                {
                    <img src="@Url.Content(Model.Thumb)" alt="Ảnh đại diện" class="img-thumbnail mt-2" style="max-width: 200px;" />
                }
                @Html.ValidationMessageFor(model => model.Thumb, "", new { @class = "text-danger" })
            </div>
        </div>

        <!-- Tags -->
        <div class="form-group row">
            @Html.LabelFor(model => model.Tags, htmlAttributes: new { @class = "col-md-3 col-form-label font-weight-bold" })
            <div class="col-md-9">
                @Html.EditorFor(model => model.Tags, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Tags, "", new { @class = "text-danger" })
            </div>
        </div>

        <!-- Nút hành động -->
        <div class="form-group row mt-4">
            <div class="col-md-9 offset-md-3">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Lưu thay đổi
                </button>
                <a class="btn btn-secondary" href="@Url.Action("Index", "AdmintblTinTucs")">
                    <i class="fas fa-arrow-left"></i> Quay lại
                </a>
            </div>
        </div>
    </div>
}

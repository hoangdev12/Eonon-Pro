@model WebBTL.Models.tblTinTuc

@{
    ViewBag.Title = "Details";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2 class="text-primary">Chi tiết bài viết</h2>

<div class="container bg-light p-4 rounded shadow-sm">
    <div class="row mb-4">
        <div class="col-md-12">
            <h4 class="text-secondary">Thông tin bài viết</h4>
            <hr />
        </div>
    </div>

    <div class="row mb-3">
        <label class="col-sm-4 col-md-3 font-weight-bold">@Html.DisplayNameFor(model => model.Title):</label>
        <div class="col-sm-8 col-md-9">
            <p class="form-control-plaintext">@Html.DisplayFor(model => model.Title)</p>
        </div>
    </div>

    <div class="row mb-3">
        <label class="col-sm-4 col-md-3 font-weight-bold">@Html.DisplayNameFor(model => model.Contents):</label>
        <div class="col-sm-8 col-md-9">
            <textarea readonly class="form-control" style="min-height: 150px;">@Model.Contents</textarea>
        </div>
    </div>

    <div class="row mb-3">
        <label class="col-sm-4 col-md-3 font-weight-bold">@Html.DisplayNameFor(model => model.Thumb):</label>
        <div class="col-sm-8 col-md-9">
            <img src="@Url.Content(@Model.Thumb)" alt="Hình ảnh bài viết" class="img-thumbnail" style="max-width: 200px;" />
        </div>
    </div>

    <div class="row mb-3">
        <label class="col-sm-4 col-md-3 font-weight-bold">@Html.DisplayNameFor(model => model.Author):</label>
        <div class="col-sm-8 col-md-9">
            <p class="form-control-plaintext">@Html.DisplayFor(model => model.Author)</p>
        </div>
    </div>

    <div class="row mb-3">
        <label class="col-sm-4 col-md-3 font-weight-bold">@Html.DisplayNameFor(model => model.Tags):</label>
        <div class="col-sm-8 col-md-9">
            <p class="form-control-plaintext">@Html.DisplayFor(model => model.Tags)</p>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12 text-center">
            <a class="btn btn-primary" href="@Url.Action("Edit", "AdmintblTinTucs", new { id = Model.PostID })">
                <i class="fas fa-edit"></i> Chỉnh sửa
            </a>
            <a class="btn btn-secondary" href="@Url.Action("Index", "AdmintblTinTucs")">
                <i class="fas fa-arrow-left"></i> Quay lại danh sách
            </a>
        </div>
    </div>
</div>

@model WebBTL.Models.tblTinTuc

@{
    ViewBag.Title = "Create";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4">Create New Article</h2>

@using (Html.BeginForm("Create", "AdmintblTinTucs", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="container">
        <div class="form-horizontal">
            <h4>Article Details</h4>
            <hr />
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <!-- Title -->
            <div class="form-group row">
                @Html.LabelFor(model => model.Title, "Title", new { @class = "col-sm-2 col-form-label" })
                <div class="col-sm-10">
                    @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
                </div>
            </div>

            <!-- Contents -->
            <div class="form-group row">
                @Html.LabelFor(model => model.Contents, "Contents", new { @class = "col-sm-2 col-form-label" })
                <div class="col-sm-10">
                    <textarea name="Contents" class="form-control" rows="6">@Model.Contents</textarea>
                    @Html.ValidationMessageFor(model => model.Contents, "", new { @class = "text-danger" })
                </div>
            </div>

            <!-- Thumbnail -->
            <div class="form-group row">
                @Html.LabelFor(model => model.Thumb, "Thumbnail", new { @class = "col-sm-2 col-form-label" })
                <div class="col-sm-10">
                    <input type="file" name="image" id="image" class="form-control" accept="image/*" />
                    @Html.ValidationMessageFor(model => model.Thumb, "", new { @class = "text-danger" })
                </div>
            </div>

            <!-- Tags -->
            <div class="form-group row">
                @Html.LabelFor(model => model.Tags, "Tags", new { @class = "col-sm-2 col-form-label" })
                <div class="col-sm-10">
                    @Html.EditorFor(model => model.Tags, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Tags, "", new { @class = "text-danger" })
                </div>
            </div>

            <!-- Buttons -->
            <div class="form-group row">
                <div class="col-sm-10 offset-sm-2">
                    <button type="submit" class="btn btn-primary">Create</button>
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary ml-2" })
                </div>
            </div>
        </div>
    </div>
}

@model WebBTL.Models.Order

@{
    ViewBag.Title = "Edit";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2 class="text-center mb-4">Edit Order</h2>

@using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "p-4 border rounded shadow-sm bg-light" }))
{
    @Html.AntiForgeryToken()

    <h4 class="text-primary">Order Details</h4>
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.OrderID)

    <div class="mb-3 row">
        @Html.LabelFor(model => model.Customer.FullName, "Customer", htmlAttributes: new { @class = "col-sm-2 col-form-label fw-bold" })
        <div class="col-sm-10">
            @Html.EditorFor(model => model.Customer.FullName, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
            @Html.ValidationMessageFor(model => model.CustomerID, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="mb-3 row">
        @Html.LabelFor(model => model.Orderdate, htmlAttributes: new { @class = "col-sm-2 col-form-label fw-bold" })
        <div class="col-sm-10">
            @Html.EditorFor(model => model.Orderdate, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
            @Html.ValidationMessageFor(model => model.Orderdate, "", new { @class = "text-danger" })
        </div>
    </div>


    <div class="mb-3 row">
        @Html.LabelFor(model => model.ShipDate, htmlAttributes: new { @class = "col-sm-2 col-form-label fw-bold" })
        <div class="col-sm-10">
            @Html.EditorFor(model => model.ShipDate, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
            @Html.ValidationMessageFor(model => model.ShipDate, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="mb-3 row">
        @Html.LabelFor(model => model.TransactStatu.Status, "Transaction Status", htmlAttributes: new { @class = "col-sm-2 col-form-label fw-bold" })
        <div class="col-sm-10">
            @Html.DropDownList("TransactStatusID", null, htmlAttributes: new { @class = "form-select" })
            @Html.ValidationMessageFor(model => model.TransactStatusID, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="mb-3 row">
        @Html.LabelFor(model => model.PaymentDate, htmlAttributes: new { @class = "col-sm-2 col-form-label fw-bold" })
        <div class="col-sm-10">
            @Html.EditorFor(model => model.PaymentDate, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
            @Html.ValidationMessageFor(model => model.PaymentDate, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="mb-3 row">
        @Html.LabelFor(model => model.TotalAmount, htmlAttributes: new { @class = "col-sm-2 col-form-label fw-bold" })
        <div class="col-sm-10">
            @Html.EditorFor(model => model.TotalAmount, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
            @Html.ValidationMessageFor(model => model.TotalAmount, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="mb-3 row">
        @Html.LabelFor(model => model.Note, htmlAttributes: new { @class = "col-sm-2 col-form-label fw-bold" })
        <div class="col-sm-10">
            <textarea name="Note" class="form-control">@Model.Note</textarea>
            @Html.ValidationMessageFor(model => model.Note, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="text-center mt-4 d-flex justify-content-end">
        <button type="submit" class="btn btn-primary px-4 mr-2">Save</button>
        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary ms-2" })
    </div>
}

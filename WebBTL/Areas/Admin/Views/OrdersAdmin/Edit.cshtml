@model WebBTL.Models.Order

@{
    ViewBag.Title = "Edit";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2 class="text-center mb-4">Edit Order</h2>

@using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "p-4 border rounded shadow-sm bg-light" }))
{
    @Html.AntiForgeryToken()

    <h4 class="text-primary">Order Details</h4>
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.OrderID)
    @Html.HiddenFor(model => model.CustomerID)

    <div class="mb-3 row">
        @Html.LabelFor(model => model.Customer.FullName, htmlAttributes: new { @class = "col-sm-2 col-form-label fw-bold" })
        <div class="col-sm-10">
            @Html.TextBoxFor(model => model.Customer.FullName, new { @class = "form-control", @readonly = "readonly" })
            @Html.ValidationMessageFor(model => model.Customer.FullName, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="mb-3 row">
        @Html.LabelFor(model => model.Orderdate, htmlAttributes: new { @class = "col-sm-2 col-form-label fw-bold" })
        <div class="col-sm-10">
            @Html.TextBoxFor(model => model.Orderdate, new { @class = "form-control", @readonly = "readonly" })
            @Html.ValidationMessageFor(model => model.Orderdate, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="mb-3 row">
        @Html.LabelFor(model => model.ShipDate, htmlAttributes: new { @class = "col-sm-2 col-form-label fw-bold" })
        <div class="col-sm-10">
            @Html.TextBoxFor(model => model.ShipDate, "{0:HH:mm}", new { @class = "form-control", type = "date" })
            @Html.ValidationMessageFor(model => model.ShipDate, "", new { @class = "text-danger" })
        </div>
    </div>


    <div class="mb-3 row">
        @Html.LabelFor(model => model.TransactStatusID, "Transaction Status", htmlAttributes: new { @class = "col-sm-2 col-form-label fw-bold" })
        <div class="col-sm-10">
            @Html.DropDownListFor(model => model.TransactStatusID, (SelectList)ViewBag.TransactStatusID, new { @class = "form-select form-control-lg border-primary" })
            @Html.ValidationMessageFor(model => model.TransactStatusID, "", new { @class = "text-danger" })
        </div>
    </div>


    <div class="mb-3 row">
        @Html.LabelFor(model => model.PaymentDate, htmlAttributes: new { @class = "col-sm-2 col-form-label fw-bold" })
        <div class="col-sm-10">
            @Html.TextBoxFor(model => model.PaymentDate, new { @class = "form-control", type = "date" })
            @Html.ValidationMessageFor(model => model.PaymentDate, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="mb-3 row">
        @Html.LabelFor(model => model.TotalAmount, htmlAttributes: new { @class = "col-sm-2 col-form-label fw-bold" })
        <div class="col-sm-10">
            @Html.TextBoxFor(model => model.TotalAmount, new { @class = "form-control", @readonly = "readonly" })
            @Html.ValidationMessageFor(model => model.TotalAmount, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="mb-3 row">
        @Html.LabelFor(model => model.Note, htmlAttributes: new { @class = "col-sm-2 col-form-label fw-bold" })
        <div class="col-sm-10">
            <textarea name="Note" class="form-control">@Model.Note</textarea>
            @Html.ValidationMessageFor(model => model.Note, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="text-center mt-4 d-flex justify-content-end">
        <button type="submit" class="btn btn-primary px-4 mr-2">Save</button>
        <a href="@Url.Action("Index")" class="btn btn-secondary ms-2">Back to List</a>
    </div>
}

@model WebBTL.Models.Product
@using WebBTL.Helper
@{
    ViewBag.Title = "Details";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}





<div class="container">
    
    <h2>Details</h2>

    <div>
        <h4>Product</h4>
        <hr />
        <dl class="dl-horizontal">
            <div class="row">
                <dt class="col-sm-6 col-md-6">
                    @Html.DisplayNameFor(model => model.ProductName)
                </dt>

                <dd class="col-sm-6 col-md-6">
                    @Html.DisplayFor(model => model.ProductName)
                </dd>
            </div>


            <div class="row">
                <dt class="col-sm-6 col-md-6">

                    @Html.DisplayNameFor(model => model.Thumb)
                </dt>

                <dd class="col-sm-6 col-md-6">

                    <img src="@Url.Content(@Model.Thumb)" alt="Alternate Text" style="width: 150px;" />



                </dd>
            </div>
            <div class="row">
                <dt class="col-sm-6 col-md-6">
                    @Html.DisplayNameFor(model => model.ShortDesc)
                </dt>

                <dd class="col-sm-6 col-md-6">
                    <textarea name="ShortDesc">@Model.ShortDesc</textarea>
                </dd>
            </div>

            <div class="row">
                <dt class="col-sm-6 col-md-6">
                    @Html.DisplayNameFor(model => model.Description)
                </dt>

                <dd class="col-sm-6 col-md-6">
                    <textarea name="ShortDesc">@Model.Description</textarea>
                </dd>
            </div>

            <div class="row">
                <dt class="col-sm-6 col-md-6">
                    @Html.DisplayNameFor(model => model.Price)
                </dt>
                <dd class="col-sm-6 col-md-6">
                    @String.Format("{0:#,##0} VND", Model.Price)
                </dd>
            </div>

            <div class="row">
                <dt class="col-sm-6 col-md-6">
                    @Html.DisplayNameFor(model => model.Discount)
                </dt>
                <dd class="col-sm-6 col-md-6">
                    @String.Format("{0:#,##0} VND", Model.Discount)
                </dd>
            </div>





            <div class="row">
                <dt class="col-sm-6 col-md-6">
                    @Html.DisplayNameFor(model => model.DateCreated)
                </dt>

                <dd class="col-sm-6 col-md-6">
                    @Html.DisplayFor(model => model.DateCreated)
                </dd>
            </div>



            <div class="row">
                <dt class="col-sm-6 col-md-6">
                    @Html.DisplayNameFor(model => model.Active)
                </dt>

                <dd class="col-sm-6 col-md-6">
                    @if (Model.UnitsInStock > 0)
                    {
                        <span class="badge badge-success">  Còn hàng</span>
                    }
                    else
                    {
                        <span class="badge badge-danger"> Hết hàng</span>
                    }
                </dd>
            </div>


            <div class="row">
                <dt class="col-sm-6 col-md-6">
                    @Html.DisplayNameFor(model => model.Tags)
                </dt>

                <dd class="col-sm-6 col-md-6">
                    @Html.DisplayFor(model => model.Tags)
                </dd>
            </div>



            <div class="row">
                <dt class="col-sm-6 col-md-6">
                    @Html.DisplayNameFor(model => model.UnitsInStock)
                </dt>

                <dd class="col-sm-6 col-md-6">
                    @Html.DisplayFor(model => model.UnitsInStock)
                </dd>
            </div>

            <div class="row">
                <dt class="col-sm-6 col-md-6">
                    @Html.DisplayNameFor(model => model.Category.CatName)
                </dt>

                <dd class="col-sm-6 col-md-6">
                    @Html.DisplayFor(model => model.Category.CatName)
                </dd>
            </div>

        </dl>
    </div>
    <p>
        @Html.ActionLink("Edit", "Edit", new { id = Model.ProductID }) |
        @Html.ActionLink("Back to List", "Index")
    </p>
</div>
@model WebBTL.Models.Order

@{
    ViewBag.Title = "Order Confirmation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section navbar {
    <div class="container-fluid bgtop2">
        <nav class="navbar navbar-expand-lg bg-warning fixed-top">
            <div class="container">
                <a class="navbar-brand" href="#"><img src="~/Content/images/logo.png" alt="Logo" style="width:100px; max-width:100px;" /></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasNavbar" aria-labelledby="offcanvasNavbarLabel">
                    <div class="offcanvas-header bg-warning">
                        <h5 class="offcanvas-title" id="offcanvasNavbarLabel">Navigation</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                    </div>
                    <div class="offcanvas-body bg-warning">
                        <ul class="navbar-nav justify-content-center flex-grow-1 pe-3">
                            <li class="nav-item"><a class="nav-link active" href="/Home/Index">Home</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Pages/About">About</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Products/Index">Products</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Pages/Contact">Contact</a></li>
                            
                            <li class="nav-item"><a class="nav-link" href="/tblTinTuc/Index">News</a></li>
                        </ul>
                        <div class="d-flex justify-content-center align-items-center gap-3">
                            @if (Session["Email"] != null)
                            {
                                <a href="@Url.Action("Profiles", "Home")" class="text-dark"><i class="fas fa-user fa-lg"></i></a>
                                <a href="@Url.Action("Cart", "Cart")" class="text-dark"><i class="fas fa-shopping-cart fa-lg"></i></a>
                                <a href="@Url.Action("Logout", "Home")" class="text-dark"><i class="fas fa-sign-out-alt fa-lg"></i></a>
                            }
                            else
                            {
                                <a href="/Home/Login" class="text-decoration-none text-dark">Login</a>
                                <a href="/Home/Register" class="btn btn-primary text-white">Sign up</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </div>
}

<div class="container mt-5 pt-5">
    <div class="text-center my-4">
        <h2 class="display-6 text-success">Đặt hàng thành công!</h2>
        <p>Đơn hàng của bạn sẽ sớm được giao tới.</p>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-warning text-white">
            <h5>Thông tin đơn hàng</h5>
        </div>
        <div class="card-body">
            <p><strong>Mã đơn hàng:</strong> @Model.OrderID</p>
            <p><strong>Thời gian đặt hàng:</strong> @(Model.Orderdate?.ToString("dd/MM/yyyy") ?? "No information")</p>
            <p><strong>Tổng tiền:</strong> @String.Format("{0:N0} VND", Model.TotalAmount)</p>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-warning text-white">
            <h5>Order Details</h5>
        </div>
        <div class="card-body">
            <table class="table table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Product</th>
                        <th>Image</th>
                        <th>Quantity</th>
                        <th>Unit Price</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var detail in Model.OrderDetails)
                    {
                        <tr>
                            <td>@detail.Product.ProductName</td>
                            <td style="width:100px;height:auto;">

                                <img src="@Url.Content(detail.Product.Thumb)" alt="Product Thumbnail" class="img-fluid" />
                            </td>
                            <td>@detail.Quantity</td>
                            <td>@String.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:C0}", detail.Discount)</td>
                            <td>@String.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:C0}", detail.Discount * detail.Quantity)</td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="text-center mt-4">
        <p>Bạn có thể xem lại đơn hàng đã đặt trong phần trang cá nhân.</p>
        <a href="/Home/OrderHistory" class="btn btn-success">Quay lại trang chủ</a>
    </div>
</div>

@model List<WebBTL.Models.CartItem>

@{
    ViewBag.Title = "Cart";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section navbar{

    <div class="container-fluid bgtop2 ">
        <nav class="navbar navbar-expand-lg bg-warning  fixed-top">
            <div class="container ">
                <a class="navbar-brand " href="#"><img src="~/Content/images/logo.png" alt="Alternate Text" style="width:100; max-width:100px;" /></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasNavbar" aria-labelledby="offcanvasNavbarLabel">
                    <div class="offcanvas-header bg-warning">
                        <h5 class="offcanvas-title" id="offcanvasNavbarLabel">Offcanvas</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                    </div>
                    <div class="offcanvas-body  bg-warning">
                        <ul class="navbar-nav justify-content-center flex-grow-1 pe-3">
                            <li class="nav-item">
                                <a class="nav-link active" aria-current="page" href="/Home/Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Pages/About">About</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Products/Index">Product</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#">Contact</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#">Service</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/tblTinTuc/Index">Tin tức</a>
                            </li>
                        </ul>
                        <div class="d-flex justify-content-center align-items-center gap-3">
                            @if (Session["Email"] != null)
                            {
                                <a href="@Url.Action("Profiles", "Home")"><i class="fas fa-user fa-lg"></i></a>
                                <a href="@Url.Action("Cart", "Cart")"><i class="fas fa-shopping-cart fa-lg"></i></a>
                                <a href="@Url.Action("Logout", "Home")" style="color:black;"><i class="fas fa-sign-out-alt fa-lg"></i></a>
                            }
                            else
                            {
                                <a href="/Home/Login" class="text-decoration-none text-black">Login</a>
                                <a href="/Home/Register" class="text-decoration-none px-3 py-1 rounded-4 text-black" style="background-color:blue;">Sign up</a>
                            }

                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </div>
}

<br />
<br />
<br />
<br />
<br />
<br />
<br />
<div class="container mt-5">
    <h2 class="text-center">Giỏ Hàng</h2>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info text-center" role="alert">
            Giỏ hàng của bạn trống.
        </div>
    }
    else
    {
<form method="post" action="@Url.Action("UpdateCart", "Cart")">
    <table class="table table-hover table-striped">
        <thead class="thead-light">
            <tr>
                <th>
                    <input type="checkbox" id="selectAll" />
                </th>
                <th>Product Name</th>
                <th>Unit Price</th>
                <th>Quantity</th>
                <th>Total</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <input type="checkbox" class="product-checkbox" name="selectedProducts" value="@item.ProductID" />
                    </td>
                    <td>
                        <img src="@item.thumb" alt="Alternate Text" style="max-width:80px; max-height:80px;" />
                        @item.ProductName
                    </td>
                    <td>@(item.UnitPrice?.ToString("C0", new System.Globalization.CultureInfo("vi-VN")))</td>
                    <td>
                        <input type="number" name="quantities[@item.ProductID]" value="@item.Quantity" min="1" class="form-control quantity-input" data-unit-price="@item.UnitPrice" style="width: 70px;" />
                    </td>
                    <td class="total-price" data-product-id="@item.ProductID">
                        @(item.TotalPrice.ToString("C0", new System.Globalization.CultureInfo("vi-VN")))
                    </td>
                    <td>
                        @Html.ActionLink("Remove", "RemoveFromCart", new { productId = item.ProductID }, new { @class = "btn btn-danger btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h3 class="d-flex justify-content-end">Total: <span id="cartTotal">@Model.Sum(i => i.TotalPrice).ToString("C0", new System.Globalization.CultureInfo("vi-VN"))</span></h3>
    <button type="submit" class="btn btn-success">Cập nhật giỏ hàng</button>
    <a href="@Url.Action("Checkout", "Cart")" class="btn btn-primary">Thanh toán</a>
</form>
    }

</div>

@section scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const quantityInputs = document.querySelectorAll('.quantity-input');
            const productCheckboxes = document.querySelectorAll('.product-checkbox');
            const cartTotalElement = document.getElementById('cartTotal');

            function updateTotalForItem(checkbox) {
                const unitPrice = parseFloat(checkbox.getAttribute('data-unit-price'));
                const quantity = parseInt(checkbox.closest('tr').querySelector('.quantity-input').value) || 0;
                return checkbox.checked ? unitPrice * quantity : 0;
            }

            function updateCartTotal() {
                let grandTotal = 0;

                productCheckboxes.forEach(checkbox => {
                    grandTotal += updateTotalForItem(checkbox);
                });

                cartTotalElement.textContent = grandTotal.toLocaleString('vi-VN', { style: 'currency', currency: 'VND' });
            }

            quantityInputs.forEach(input => {
                input.addEventListener('input', function () {
                    const totalPriceElement = this.closest('tr').querySelector('.total-price');
                    totalPriceElement.textContent = (parseFloat(this.value) * parseFloat(this.getAttribute('data-unit-price'))).toLocaleString('vi-VN', { style: 'currency', currency: 'VND' });
                    updateCartTotal();
                });
            });

            productCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function () {
                    updateCartTotal();
                });
            });

            // Select all checkbox
            const selectAllCheckbox = document.getElementById('selectAll');
            selectAllCheckbox.addEventListener('change', function () {
                productCheckboxes.forEach(checkbox => {
                    checkbox.checked = selectAllCheckbox.checked;
                });
                updateCartTotal();
            });
        });
    </script>
}

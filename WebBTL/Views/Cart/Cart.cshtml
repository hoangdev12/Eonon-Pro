@model List<WebBTL.Models.CartItem>

@{
    ViewBag.Title = "Giỏ Hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section navbar {
    <div class="container-fluid bgtop2">
        <nav class="navbar navbar-expand-lg bg-warning fixed-top">
            <div class="container">
                <a class="navbar-brand" href="#"><img src="~/Content/images/logo.png" alt="Logo" style="width:100px; max-width:100px;" /></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasNavbar" aria-labelledby="offcanvasNavbarLabel">
                    <div class="offcanvas-header bg-warning">
                        <h5 class="offcanvas-title" id="offcanvasNavbarLabel">Navigation</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                    </div>
                    <div class="offcanvas-body bg-warning">
                        <ul class="navbar-nav justify-content-center flex-grow-1 pe-3">
                            <li class="nav-item"><a class="nav-link active" href="/Home/Index">Home</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Pages/About">About</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Products/Index">Products</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Pages/Contact">Contact</a></li>
                            
                            <li class="nav-item"><a class="nav-link" href="/tblTinTuc/Index">Tin tức</a></li>
                        </ul>
                        <div class="d-flex justify-content-center align-items-center gap-3">
                            @if (Session["Email"] != null)
                            {
                                <a href="@Url.Action("Profiles", "Home")"><i class="fas fa-user fa-lg"></i></a>
                                <a href="@Url.Action("Cart", "Cart")"><i class="fas fa-shopping-cart fa-lg"></i></a>
                                <a href="@Url.Action("Logout", "Home")" style="color:black;"><i class="fas fa-sign-out-alt fa-lg"></i></a>
                            }
                            else
                            {
                                <a href="/Home/Login" class="text-decoration-none text-black">Login</a>
                                <a href="/Home/Register" class="text-decoration-none px-3 py-1 rounded-4 text-black" style="background-color:blue;">Sign up</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </div>
}

<br />
<br />
<div class="container mt-5 pt-5">
    <h2 class="text-center">Giỏ Hàng</h2>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info text-center" role="alert">
            Giỏ hàng của bạn trống.
        </div>
    }
    else
    {
        <table class="table table-hover table-striped text-center align-middle">
            <thead class="thead-light">
                <tr>
                    <th>Product Name</th>
                    <th>Unit Price</th>
                    <th>Quantity</th>
                    <th>Total</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="d-flex align-items-center gap-3">
                            <img src="@item.thumb" alt="@item.ProductName" class="img-thumbnail" style="max-width:80px; max-height:80px;" />
                            <span>@item.ProductName</span>
                        </td>
                        <td>@(item.UnitPrice?.ToString("C0", new System.Globalization.CultureInfo("vi-VN")))</td>
                        <td>
                            @using (Html.BeginForm("UpdateQuantities", "Cart", FormMethod.Post))
                            {
                                <input type="hidden" name="productId" value="@item.ProductID" />
                                <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control d-inline-block text-center" style="width:50px;"/>
                                <button type="submit" class="btn btn-outline-primary mt-2">Cập nhật</button>
                            }
                        </td>
                        <td>@(item.TotalPrice.ToString("C0", new System.Globalization.CultureInfo("vi-VN")))</td>
                        <td>
                            @Html.ActionLink("Remove", "RemoveFromCart", new { productId = item.ProductID }, new { @class = "btn btn-danger btn-sm" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-between align-items-center mt-4">
            <a href="@Url.Action("Checkout", "Cart")" class="btn btn-primary px-4 py-2">Thanh toán</a>
            <p class="h5"><strong>Tổng cộng: @(Model.Sum(item => item.TotalPrice).ToString("C0", new System.Globalization.CultureInfo("vi-VN")))</strong></p>
        </div>
    }
</div>

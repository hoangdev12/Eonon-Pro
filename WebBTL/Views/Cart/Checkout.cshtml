@model List<WebBTL.Models.CartItem>

@{
    ViewBag.Title = "Checkout";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section navbar {
    <div class="container-fluid bgtop2">
        <nav class="navbar navbar-expand-lg bg-warning fixed-top">
            <div class="container">
                <a class="navbar-brand" href="#"><img src="~/Content/images/logo.png" alt="Logo" style="width:100px; max-width:100px;" /></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasNavbar" aria-labelledby="offcanvasNavbarLabel">
                    <div class="offcanvas-header bg-warning">
                        <h5 class="offcanvas-title" id="offcanvasNavbarLabel">Navigation</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                    </div>
                    <div class="offcanvas-body bg-warning">
                        <ul class="navbar-nav justify-content-center flex-grow-1 pe-3">
                            <li class="nav-item"><a class="nav-link active" href="/Home/Index">Home</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Pages/About">About</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Products/Index">Product</a></li>
                            <li class="nav-item"><a class="nav-link" href="#">Contact</a></li>
                            <li class="nav-item"><a class="nav-link" href="#">Service</a></li>
                            <li class="nav-item"><a class="nav-link" href="/tblTinTuc/Index">Tin tức</a></li>
                        </ul>
                        <div class="d-flex justify-content-center align-items-center gap-3">
                            @if (Session["Email"] != null)
                            {
                                <a href="@Url.Action("Profiles", "Home")"><i class="fas fa-user fa-lg"></i></a>
                                <a href="@Url.Action("Cart", "Cart")"><i class="fas fa-shopping-cart fa-lg"></i></a>
                                <a href="@Url.Action("Logout", "Home")" style="color:black;"><i class="fas fa-sign-out-alt fa-lg"></i></a>
                            }
                            else
                            {
                                <a href="/Home/Login" class="text-decoration-none text-black">Login</a>
                                <a href="/Home/Register" class="text-decoration-none px-3 py-1 rounded-4 text-black" style="background-color:blue;">Sign up</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </div>
}

<br />
<br />

<div class="container mt-5 pt-5">
    <h2 class="text-center mb-4">Thanh toán</h2>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info text-center" role="alert">
            Giỏ hàng của bạn trống. Không thể tiến hành thanh toán.
        </div>
    }
    else
    {
        <h4 class="mb-3">Thông tin đơn hàng:</h4>
        <div class="table-responsive">
            <table class="table table-bordered text-center align-middle">
                <thead class="table-light">
                    <tr>
                        <th>SP</th>
                        <th>Tên sản phẩm</th>
                        <th>Số lượng</th>
                        <th>Đơn giá</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><img src="@Url.Content(item.thumb)" alt="Product Image" class="img-thumbnail" style="max-width:100px; max-height:100px;" /></td>
                            <td>@item.ProductName</td>
                            <td>@item.Quantity</td>
                            <td>@String.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:C0}", item.UnitPrice)</td>
                            <td>@String.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:C0}", item.UnitPrice * item.Quantity)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="text-end mb-4">
            <p class="h5"><strong>Tổng cộng: @String.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:C0}", Model.Sum(item => item.UnitPrice * item.Quantity))</strong></p>
        </div>

        using (Html.BeginForm("Checkout", "Cart", FormMethod.Post))
        {
            <div class="text-end">
                <button type="submit" class="btn btn-success px-4 py-2">Xác nhận thanh toán</button>
            </div>
        }
    }
</div>

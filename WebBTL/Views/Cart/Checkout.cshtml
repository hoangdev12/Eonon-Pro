@model List<WebBTL.Models.CartItem>

@{
    ViewBag.Title = "Checkout";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Checkout</h2>

@if (Model.Count == 0)
{
    <p>Giỏ hàng của bạn trống. Không thể tiến hành thanh toán.</p>
}
else
{
    <h4>Thông tin đơn hàng:</h4>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.Quantity</td>
                    <td>@String.Format("{0:C}", item.UnitPrice)</td>
                    <td>@String.Format("{0:C}", item.UnitPrice * item.Quantity)</td>
                </tr>
            }
        </tbody>
    </table>

    <p><strong>Tổng cộng: @String.Format("{0:C}", Model.Sum(item => item.UnitPrice * item.Quantity))</strong></p>

    using (Html.BeginForm("Checkout", "Cart", FormMethod.Post))
    {
        <button type="submit" class="btn btn-success">Xác nhận thanh toán</button>
    }
}
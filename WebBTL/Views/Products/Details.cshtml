<style>
    .blog-image-video img {
        height: auto;
        width: 100%;
        object-fit: cover;
    }

    .footer-logo img {
        height: auto;
        width: 80%;
        margin: 0 0 20px;
    }

    #specification table {
        max-width: 100% !important;
    }



    .blog-single-wrapper ul, .blog-single-wrapper ol {
        list-style: inherit;
        margin: auto;
        padding: revert-layer;
    }

    .blog-single-wrapper a {
        color: #0D6EFD;
    }

    form.form--search--mb {
        display: flex;
        flex: 0 0 100%;
    }

    button.btn-search, .close--search {
        width: 50px;
        height: 67px;
    }

    a.close--search {
        color: #fff;
        width: 50px;
        flex-shrink: 1;
        flex-grow: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 20px;
        background: #000000;
    }

    button.btn-search {
        background: #ffc107;
        color: #fff;
        flex-shrink: 1;
        flex-grow: 1;
        width: 66px;
    }

    .search--mb {
        display: none;
    }

    form.form--search--mb input.form-control {
        border-radius: 0;
    }
</style>

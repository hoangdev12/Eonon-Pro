@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section navbar{

    <div class="container-fluid bgtop2 ">
        <nav class="navbar navbar-expand-lg bg-warning  fixed-top">
            <div class="container ">
                <a class="navbar-brand " href="#"><img src="~/Content/images/logo.png" alt="Alternate Text" style="width:100; max-width:100px;" /></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasNavbar" aria-labelledby="offcanvasNavbarLabel">
                    <div class="offcanvas-header bg-warning">
                        <h5 class="offcanvas-title" id="offcanvasNavbarLabel">Offcanvas</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                    </div>
                    <div class="offcanvas-body  bg-warning">
                        <ul class="navbar-nav justify-content-center flex-grow-1 pe-3">
                            <li class="nav-item">
                                <a class="nav-link active" aria-current="page" href="/Home/Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Pages/About">About</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Products/Index">Product</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Pages/Contact">Contact</a>
                            </li>
                           
                            <li class="nav-item">
                                <a class="nav-link" href="/tblTinTuc/Index">Tin tức</a>
                            </li>
                        </ul>
                        <div class="d-flex justify-content-center align-items-center gap-3">
                            @if (Session["Email"] != null)
                            {
                                <a href="@Url.Action("Profiles", "Home")"><i class="fas fa-user fa-lg"></i></a>
                                <a href="@Url.Action("Cart", "Cart")"><i class="fas fa-shopping-cart fa-lg"></i></a>
                                <a href="@Url.Action("Logout", "Home")" style="color:black;"><i class="fas fa-sign-out-alt fa-lg"></i></a>
                            }
                            else
                            {
                                <a href="/Home/Login" class="text-decoration-none text-black">Login</a>
                                <a href="/Home/Register" class="text-decoration-none px-3 py-1 rounded-4 text-black" style="background-color:blue;">Sign up</a>
                            }

                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </div>
}


<section>

    @foreach (var product in Model)
    {
        @* banner tin tiuc *@
        <section style="margin-top:70px">
            <div class="bannerTinTuc">
                <div class="container" style="padding-top:50px">
                    <div class="row">
                        <div class="col-12 d-flex justify-content-center align-items-center">
                            <span style="color:#FFF; font-size:24px;">@product.ProductName</span>

                        </div>
                    </div>
                </div>
            </div>
        </section>

        <br />
        <br />

        <div class="container">
            <div class="row">
                <div class="col-sm-4 col-md-4">
                    <img src="@product.Thumb" alt="Alternate Text" style="max-width:400px;max-height:500px;" />
                </div>
                <div class="col-sm-4 col-md-4">
                    <h3>@product.ProductName</h3>
                    <h4 style="color: #fdcc0d">@String.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:C0}", product.Price)</h4>
                    <p>@Html.Raw(product.ShortDesc)</p>
                    <br />
                    <br />
                    <a href="@Url.Action("AddToCart", "Cart", new { productId = product.ProductID, quantity = 1 })" class="btn btn-outline-warning col-6 text-black" style="max-height:40px;">
                        <i class="fas fa-shopping-cart" style="color: #000;"></i> Mua hàng
                    </a>
                </div>
                <div class="side col-sm-4 col-md-4">
                    <div class="box-visao">
                        <h2>VÌ SAO CHỌN EONON PRO ?</h2>
                        <div class="d-flex align-items-baseline mb-2">
                            <div class="lo">
                                <img src="https://eononpro.vn/assets/images/ii/chinh-hang.png" alt="">
                            </div>
                            <div class="pl-5">
                                <h3>Sản phẩm chính hãng</h3>
                                <p></p>
                            </div>
                        </div>
                        <div class="d-flex align-items-baseline mb-2">
                            <div class="lo">
                                <img src="https://eononpro.vn/assets/images/ii/bao-hanh.png" alt="">
                            </div>
                            <div class="pl-5">
                                <h3>Trên 200 Ðại lý toàn quốc</h3>
                                <p></p>
                            </div>
                        </div>
                        <div class="d-flex align-items-baseline mb-2">
                            <div class="lo">
                                <img src="https://eononpro.vn/assets/images/ii/hh2.png" alt="">
                            </div>
                            <div class="pl-5">
                                <h3>Màn hình công nghệ QLED</h3>
                                <p></p>
                            </div>
                        </div>
                        <div class="d-flex align-items-baseline mb-2">
                            <div class="lo">
                                <img src="https://eononpro.vn/assets/images/ii/hh1.png" alt="">
                            </div>
                            <div class="pl-5">
                                <h3>Bảo hành lên tới 2 nam</h3>
                                <p></p>
                            </div>
                        </div>
                        <div class="d-flex align-items-baseline mb-2">
                            <div class="lo">
                                <img src="https://eononpro.vn/assets/images/ii/doi-mot.png" alt="">
                            </div>
                            <div class="pl-5">
                                <h3>1 dổi 1 trong vòng 1 nam</h3>
                                <p></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>



        @Html.Raw(product.Description)

        <h4 class="text-center align-center">SẢN PHẨM LIÊN QUAN</h4>
        <br />

        if (ViewBag.lsSanPhamLienQuan != null && ViewBag.lsSanPhamLienQuan.Count > 0)
        {
            <div class="container">
                <div class="row">
                    @foreach (var item in ViewBag.lsSanPhamLienQuan)
                    {
                        <div class="col-sm-4 col-md-4 pb-3">
                            <div class="card h-100 ">
                                <a href="@Url.Action("Details", "Products", new { id = item.ProductID })">
                                    <img src="@item.Thumb" class="card-img-top" alt="error">
                                </a>
                                <div class="card-body">
                                    <h5 class="card-title">
                                        Đăng bởi:
                                        <a href="@Url.Action("Details", "Products", new { id = item.ProductID })" style="font-size:14px;text-decoration:none;opacity:0.5;color:black;" class="linkTinTuc">
                                            @item.ProductName
                                        </a>
                                    </h5>
                                    <br />
                                    <a href="@Url.Action("Details", "Products", new { id = item.ProductID })" style="text-decoration: none; color:black; font-size:20px;" class="linkTinTuc">
                                        <p class="card-text">
                                            @String.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:C0}", item.Price)
                                        </p>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

        }
        else
        {
            <li>Không có bài viết liên quan nào.</li>
        }
    }


</section>
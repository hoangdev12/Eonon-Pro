<style>
    .logo-container {
        margin: 10px; /* Khoảng cách giữa các logo */
        border: 2px solid #ddd; /* Viền màu xám nhạt */
        border-radius: 10px; /* Bo tròn góc thẻ div */
        padding: 10px; /* Khoảng cách bên trong thẻ div */
        width: 160px; /* Chiều rộng cố định của thẻ div */
        height: 160px; /* Chiều cao cố định của thẻ div */
        display: flex; /* Sử dụng flexbox */
        align-items: center; /* Căn giữa theo chiều dọc */
        justify-content: center; /* Căn giữa theo chiều ngang */
    }

        .logo-container img {
            max-width: 100%; /* Đảm bảo hình ảnh không vượt quá kích thước thẻ div */
            height: auto; /* Duy trì tỷ lệ hình ảnh */
            border-radius: 5px; /* Bo tròn góc ảnh */
        }

    .blog-image-video img {
        height: auto;
        width: 100%;
        object-fit: cover;
    }

    .footer-logo img {
        height: auto;
        width: 80%;
        margin: 0 0 20px;
    }

    #specification table {
        max-width: 100% !important;
    }

    .blog-single-wrapper ul, .blog-single-wrapper ol {
        list-style: inherit;
        margin: auto;
        padding: revert-layer;
    }

    .blog-single-wrapper a {
        color: #0D6EFD;
    }

    form.form--search--mb {
        display: flex;
        flex: 0 0 100%;
    }

    button.btn-search, .close--search {
        width: 50px;
        height: 67px;
    }

    a.close--search {
        color: #fff;
        width: 50px;
        flex-shrink: 1;
        flex-grow: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 20px;
        background: #000000;
    }

    button.btn-search {
        background: #ffc107;
        color: #fff;
        flex-shrink: 1;
        flex-grow: 1;
        width: 66px;
    }

    .search--mb {
        display: none;
    }

    form.form--search--mb input.form-control {
        border-radius: 0;
    }
</style>
@section navbar{

